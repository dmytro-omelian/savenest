{
  "name": "savenest-desktop",
  "productName": "SaveNest",
  "version": "0.11.1",
  "private": true,
  "description": "SaveNest Electron desktop with native macOS capture and local storage",
  "main": "electron/main.cjs",
  "scripts": {
    "build:native": "CONFIGURATION=debug ELECTRON_HELPER=1 APP_PATH=build/electron-native/SaveNest.app bash scripts/build-app.sh",
    "prestart": "npm run build:native",
    "start": "electron .",
    "prepreview": "npm run build:native",
    "preview": "electron . --preview",
    "test": "node --test electron/tests/*.test.cjs",
    "test:smoke": "npm run build:native && electron . --preview --smoke-test",
    "build": "CONFIGURATION=release ELECTRON_HELPER=1 APP_PATH=build/electron-native/SaveNest.app bash scripts/build-app.sh && node scripts/package-electron.mjs",
    "release:electron": "node scripts/package-electron-release.mjs"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/osx-sign": "2.7.2",
    "@electron/packager": "20.3.0",
    "electron": "45.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "os": [
    "darwin"
  ],
  "license": "MIT"
}
